# Copy to /etc/yt-transcribe/vimeo.env, then: sudo chmod 600, sudo chown root:root
# This file is read only by the systemd unit. Never commit a filled-in copy.

# The channel URL to archive (videos, shorts and livestream VODs are merged).
CHANNEL_URL=https://vimeo.com/user/REPLACE_USER_ID/folder/REPLACE_FOLDER_ID

# Netscape-format cookie file you exported from your own signed-in browser and
# transferred with scp. Keep it outside the repo; chmod 600.
COOKIES_FILE=/home/ubuntu/secrets/vimeo_cookies.txt

# Optional overrides (defaults shown).
WHISPER_MODEL=small          # tiny|base|small|medium|large-v3 -- CPU cost scales steeply
DIARIZE=1                    # 1 enables --diarize (forces an audio download for EVERY video)
RETRIES=3
OMP_NUM_THREADS=2            # 2 per unit so both units share 4 OCPUs; use 4 if running alone
#EXTRA_ARGS=--limit 25       # handy for a first smoke test

# REQUIRED for Vimeo folder discovery. yt-dlp has no "folder" extractor, so
# channel_transcriber/vimeo_api.py enumerates the folder through Vimeo's REST
# API and reads this token from the environment. Create it at
# https://developer.vimeo.com/apps with Public + Private read scopes.
# Paste the value here on the server only -- never into chat, never into git.
VIMEO_ACCESS_TOKEN=REPLACE_ME

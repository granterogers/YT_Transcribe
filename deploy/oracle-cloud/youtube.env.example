# Copy to /etc/yt-transcribe/youtube.env, then: sudo chmod 600, sudo chown root:root
# This file is read only by the systemd unit. Never commit a filled-in copy.

# The channel URL to archive (videos, shorts and livestream VODs are merged).
CHANNEL_URL=https://www.youtube.com/@REPLACE_ME

# Netscape-format cookie file you exported from your own signed-in browser and
# transferred with scp. Keep it outside the repo; chmod 600.
COOKIES_FILE=/home/ubuntu/secrets/youtube_cookies.txt

# Optional overrides (defaults shown).
WHISPER_MODEL=small          # tiny|base|small|medium|large-v3 -- CPU cost scales steeply
DIARIZE=1                    # 1 enables --diarize (forces an audio download for EVERY video)
INCLUDE_SHORTS=1
INCLUDE_LIVESTREAMS=1
RETRIES=3
OMP_NUM_THREADS=2            # 2 per unit so both units share 4 OCPUs; use 4 if running alone
#EXTRA_ARGS=--limit 25       # handy for a first smoke test
